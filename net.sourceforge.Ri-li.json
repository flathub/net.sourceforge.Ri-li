{
    "app-id": "net.sourceforge.Ri-li",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "26.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "Ri_li",
    "rename-appdata-file": "Ri-li.appdata.xml",
    "rename-desktop-file": "Ri-li.desktop",
    "rename-icon": "Ri-li",
    "finish-args": [
        "--device=dri",
        "--share=ipc",
        "--socket=x11",
        "--socket=pulseaudio"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/aclocal",
        "/share/man",
        "*.la",
        "*.a"
    ],
    "modules": [
        "shared-modules/SDL/SDL-1.2.15.json",
        "shared-modules/smpeg/smpeg-0.4.5.json",
        "shared-modules/SDL/SDL_mixer-1.2.12.json",
        {
            "name": "ri-li",
            "post-install": [
                "install -Dm644 Ri-li.appdata.xml -t /app/share/metainfo",
                "install -Dm644 Ri-li.desktop -t /app/share/applications/",
                "install -Dm644 ri-li-128.png /app/share/icons/hicolor/128x128/apps/Ri-li.png",
                "install -Dm644 ri-li-256.png /app/share/icons/hicolor/256x256/apps/Ri-li.png",
                "install -Dm644 ri-li-512.png /app/share/icons/hicolor/512x512/apps/Ri-li.png"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://downloads.sourceforge.net/sourceforge/ri-li/Ri-li-2.0.1.tar.bz2",
                    "sha256": "f71ccc20c37c601358d963e087ac0d524de8c68e96df09c3aac1ae65edd38dbd"
                },
                {
                    "type": "patch",
                    "paths": [
                      "patches/Ri-li-2.0.1-build-fix.patch",
                      "patches/Ri-li-gcc11.patch",
                      "patches/Ri-li-2.0.1-gcc43.patch",
                      "patches/Ri-li-xdg-config-home.patch"
                    ]
                },
                {
                    "type": "file",
                    "path": "Ri-li.appdata.xml"
                },
                {
                    "type": "file",
                    "path": "Ri-li.desktop"
                },
                {
                    "type": "file",
                    "path": "ri-li-128.png"
                },
                {
                    "type": "file",
                    "path": "ri-li-256.png"
                },
                {
                    "type": "file",
                    "path": "ri-li-512.png"
                }
            ]
        }
    ]
}
